                    {% endif %}
                  </div>
                {% endif %}
                {% if content.position %}
                  <div style="font-style: italic; color: var(--global-text-color-light); font-size: 0.95rem;">
                    {{ content.position }}
                  </div>
                {% endif %}
              </div>
              <div class="text-right flex-shrink-0 mt-1 mt-sm-0">
                {% if date != '' %}
                  <div>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle">
                      {{ date }}
                    </span>
                  </div>
                {% endif %}
                {% if location and location != '' %}
                  <div class="location" style="font-size: 0.75rem; color: var(--global-text-color-light); margin-top: 0.2rem;">
                    <i class="fa-solid fa-location-dot fa-xs"></i> {{ location }}
                  </div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>
