<div class="news">
  {% if page.latest_posts != blank %}
    {% assign visible_posts = site.posts | where_exp: "item", "item.hidden != true" %}
    {% assign latest_posts_size = visible_posts | size %}
    {% if latest_posts_size > 0 %}
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          {% assign latest_posts = visible_posts %}
          {% if page.latest_posts.limit %}
            {% assign latest_posts_limit = page.latest_posts.limit %}
          {% else %}
            {% assign latest_posts_limit = latest_posts_size %}
          {% endif %}
          {% for item in latest_posts limit: latest_posts_limit %}
            <tr>
              <th scope="row" style="width: 22%; font-family: var(--global-font-family-mono, monospace); font-weight: normal; font-size: 0.85rem; color: var(--global-text-color-light);">
                {{ item.date | date: '%Y.%m.%d' }}
              </th>
              <td>
                {% if item.redirect == blank %}
                  <a class="news-title font-weight-bold" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% elsif item.redirect contains '://' %}
                  <a class="news-title font-weight-bold" href="{{ item.redirect }}" target="_blank">{{ item.title }} &#8599;</a>
                {% else %}
                  <a class="news-title font-weight-bold" href="{{ item.redirect | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% else %}
      <p class="text-muted" style="font-family: var(--global-font-family-mono, monospace); font-size: 0.85rem;">[no posts yet &mdash; first release coming soon]</p>
    {% endif %}
  {% else %}
    <p class="text-muted" style="font-family: var(--global-font-family-mono, monospace); font-size: 0.85rem;">[no posts yet &mdash; first release coming soon]</p>
  {% endif %}
</div>
